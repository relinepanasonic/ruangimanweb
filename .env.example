# --- Blog content -----------------------------------------------------------
# This site READS the Ruang Iman app's Supabase project (table: public.blog_posts).
# The anon key is enough: RLS policy "Public can read published posts" already lets
# anonymous visitors select rows where status = 'published'. Never put the
# service-role key here — this site never writes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Links ------------------------------------------------------------------
# Where every call-to-action button on this site sends people.
NEXT_PUBLIC_APP_URL=https://apps.priasejatikatolik.id/

# This marketing site's own public URL — used for canonical tags, OG tags and
# the sitemap. Set it to the real domain once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
